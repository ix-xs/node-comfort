---
// The API reference in French. Its English original is ../../reference/.
import IndexPage from "../../../components/reference/IndexPage.astro";
import NamespacePage from "../../../components/reference/NamespacePage.astro";
import SymbolPage from "../../../components/reference/SymbolPage.astro";
import { namespaces, symbols } from "../../../reference/model";

export function getStaticPaths() {
  return [
    { params: { slug: undefined }, props: {} },
    ...namespaces.map((ns) => ({ params: { slug: ns.slug }, props: { ns } })),
    ...symbols.map((symbol) => ({ params: { slug: symbol.ref }, props: { symbol } })),
  ];
}

const { ns, symbol } = Astro.props;
---

{symbol ? <SymbolPage symbol={symbol} locale="fr" /> : ns ? <NamespacePage ns={ns} locale="fr" /> : <IndexPage locale="fr" />}
