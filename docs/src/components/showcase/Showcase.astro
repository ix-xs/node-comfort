---
// The landing page's showcase: pick a subject, then a variation, read the
// file, and see what it printed when `scripts/showcase.mjs` ran it against the
// package. Everything is in the page from the start; the script below only
// decides what is shown, and plays the output again.
import { Code } from "@astrojs/starlight/components";
import { useT } from "../../i18n";
import { SCENES } from "../../showcase/scenes.mjs";
import output from "../../showcase/output.json";
import "../../styles/showcase.css";

type Run = { code: string; html: string; ms: number };
const runs = output as Record<string, Record<string, Run>>;

const { locale } = Astro.locals.starlightRoute;
const t = useT(locale);
const language = locale === "fr" ? "fr" : "en";
const two = (n: number) => String(n).padStart(2, "0");
---

<nc-showcase class="nc-show" aria-label={t("showcase.label")}>
  <div class="nc-show-rail" role="tablist" aria-label={t("showcase.scenes")}>
    {SCENES.map((scene, index) => (
      <button type="button" role="tab" id={`nc-tab-${scene.id}`} aria-controls={`nc-panel-${scene.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>
        <span aria-hidden="true">{two(index + 1)}</span>{scene.label}
      </button>
    ))}
    <span class="nc-show-mark" aria-hidden="true"></span>
  </div>

  {SCENES.map((scene, index) => (
    <section class="nc-show-panel" role="tabpanel" id={`nc-panel-${scene.id}`} aria-labelledby={`nc-tab-${scene.id}`} hidden={index !== 0}>
      <div class="nc-show-head">
        <p>{scene.about[language]}</p>
        <div class="nc-show-variants" role="group" aria-label={t("showcase.variants")}>
          {scene.variants.map((variant, at) => (
            <button class="nc-press" type="button" data-variant={variant.id} aria-pressed={at === 0 ? "true" : "false"}>{variant.label}</button>
          ))}
        </div>
      </div>
      {scene.variants.map((variant, at) => {
        const run = runs[scene.id][variant.id];
        return (
          <div class="nc-show-run" data-variant={variant.id} hidden={at !== 0}>
            <div class="nc-show-code">
              <Code code={run.code} lang="js" title={`${variant.id}.js`} />
            </div>
            <div class="nc-term">
              <header>
                <span class="nc-term-title">{t("showcase.output")}</span>
                <span class="nc-term-time" data-time={t("showcase.ran", { ms: run.ms })}></span>
                <button class="nc-term-run nc-press" type="button" data-run>
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2.5 1.2v9.6a.5.5 0 0 0 .76.43l8-4.8a.5.5 0 0 0 0-.86l-8-4.8a.5.5 0 0 0-.76.43Z"></path></svg>
                  <span>{t("showcase.again")}</span>
                </button>
              </header>
              <pre tabindex="0"><code set:html={run.html} /></pre>
            </div>
          </div>
        );
      })}
    </section>
  ))}
</nc-showcase>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  class Showcase extends HTMLElement {
    private rail = this.querySelector<HTMLElement>(".nc-show-rail");
    private tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    private mark = this.querySelector<HTMLElement>(".nc-show-mark");
    // Whether the last thing the reader did here was with a pointer: the mark
    // slides for a pointer and jumps for the keyboard.
    private pointer = false;

    connectedCallback(): void {
      this.addEventListener("pointerdown", () => (this.pointer = true));
      this.addEventListener("keydown", (event) => {
        this.pointer = false;
        this.onKey(event);
      });
      this.addEventListener("click", (event) => {
        const target = event.target as Element | null;
        const tab = target?.closest<HTMLButtonElement>('[role="tab"]');
        if (tab) return this.select(tab);
        const variant = target?.closest<HTMLButtonElement>(".nc-show-variants button");
        if (variant) return this.choose(variant);
        const run = target?.closest<HTMLButtonElement>("[data-run]");
        if (run) this.play(run.closest<HTMLElement>(".nc-show-run"));
      });
      addEventListener("resize", () => this.place(false));
      // The tabs change width once their font arrives.
      document.fonts?.ready.then(() => this.place(false));
      this.place(false);
      // The first output plays when the showcase comes into view, once.
      new IntersectionObserver(
        (entries, watcher) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          watcher.disconnect();
          this.play(this.current());
        },
        { threshold: 0.35 },
      ).observe(this);
    }

    /** The run on screen. */
    private current(): HTMLElement | null {
      return this.querySelector<HTMLElement>(".nc-show-panel:not([hidden]) .nc-show-run:not([hidden])");
    }

    private onKey(event: KeyboardEvent): void {
      const tab = (event.target as Element | null)?.closest<HTMLButtonElement>('[role="tab"]');
      if (!tab) return;
      const at = this.tabs.indexOf(tab);
      const to = event.key === "ArrowRight" ? at + 1 : event.key === "ArrowLeft" ? at - 1 : event.key === "Home" ? 0 : event.key === "End" ? this.tabs.length - 1 : -2;
      if (to === -2) return;
      event.preventDefault();
      const next = this.tabs[(to + this.tabs.length) % this.tabs.length];
      next.focus();
      this.select(next);
    }

    private select(tab: HTMLButtonElement): void {
      if (tab.getAttribute("aria-selected") === "true") return;
      for (const other of this.tabs) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        other.tabIndex = selected ? 0 : -1;
        const panel = this.querySelector<HTMLElement>(`#${other.getAttribute("aria-controls")}`);
        if (panel) panel.hidden = !selected;
      }
      this.place(this.pointer);
      // Bring the tab into view inside the rail only: the page itself stays where it is.
      if (this.rail) {
        const left = tab.offsetLeft - 24;
        const right = tab.offsetLeft + tab.offsetWidth + 24 - this.rail.clientWidth;
        if (this.rail.scrollLeft > left) this.rail.scrollLeft = Math.max(0, left);
        else if (this.rail.scrollLeft < right) this.rail.scrollLeft = right;
      }
      this.play(this.current());
    }

    private choose(button: HTMLButtonElement): void {
      const panel = button.closest<HTMLElement>(".nc-show-panel");
      if (!panel || button.getAttribute("aria-pressed") === "true") return;
      for (const other of panel.querySelectorAll<HTMLButtonElement>(".nc-show-variants button")) other.setAttribute("aria-pressed", String(other === button));
      for (const run of panel.querySelectorAll<HTMLElement>(".nc-show-run")) run.hidden = run.dataset.variant !== button.dataset.variant;
      this.play(this.current());
    }

    /** Moves the mark under the selected tab. It is 100px long and scaled to the tab. */
    private place(animate: boolean): void {
      const active = this.tabs.find((tab) => tab.getAttribute("aria-selected") === "true");
      if (!active || !this.mark || active.offsetWidth === 0) return;
      this.mark.toggleAttribute("data-slide", animate && !reduced.matches);
      this.mark.style.transform = `translateX(${active.offsetLeft}px) scaleX(${active.offsetWidth / 100})`;
      this.mark.setAttribute("data-placed", "");
    }

    /** Prints the output again, a line at a time, as a program would. */
    private play(run: HTMLElement | null): void {
      if (!run) return;
      const lines = [...run.querySelectorAll<HTMLElement>(".nc-line")];
      const time = run.querySelector<HTMLElement>(".nc-term-time");
      for (const line of lines) for (const animation of line.getAnimations()) animation.cancel();
      if (time) time.textContent = "";
      const done = () => {
        if (time) time.textContent = time.dataset.time ?? "";
      };
      if (reduced.matches || lines.length === 0) return done();
      // Short outputs take their time, long ones don't make you wait: the last line starts within 420 ms.
      const gap = Math.min(45, 420 / lines.length);
      let last: Animation | undefined;
      lines.forEach((line, index) => {
        last = line.animate(
          [
            { opacity: 0, transform: "translateY(4px)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: 220, delay: index * gap, easing: "cubic-bezier(0.23, 1, 0.32, 1)", fill: "backwards" },
        );
      });
      last?.finished.then(done, () => {});
    }
  }
  customElements.define("nc-showcase", Showcase);
</script>
