---
// The head of a page: which part of the docs this is, the title, and the
// page's description as a lead paragraph. Descriptions are written like the
// rest of the docs, with `code` in backticks.
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entry = StarlightRouteData["sidebar"][number];

/** The labels of the groups that contain the current page, outermost first. */
function trail(entries: Entry[], path: string[] = []): string[] | undefined {
  for (const entry of entries) {
    if (entry.type === "link") {
      if (entry.isCurrent) return path;
    } else {
      const found = trail(entry.entries, [...path, entry.label]);
      if (found) return found;
    }
  }
  return undefined;
}

const escape = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
/** Backticks become code, everything else is plain text. */
const withCode = (text: string) =>
  text
    .split("`")
    .map((piece, index) => (index % 2 === 1 ? `<code>${escape(piece)}</code>` : escape(piece)))
    .join("");

const { entry, sidebar } = Astro.locals.starlightRoute;
const groups = trail(sidebar) ?? [];
const lead = entry.data.description;
---

{groups.length > 0 && <p class="nc-eyebrow">{groups.join(" / ")}</p>}
<h1 id="_top" class="nc-title">{entry.data.title}</h1>
{lead && <p class="nc-lead" set:html={withCode(lead)} />}
